<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section
    id="home-page"
    class="grid min-h-[calc(100vh-9rem)] items-center gap-8 py-6 lg:grid-cols-[1.1fr_0.9fr]"
  >
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700 dark:text-emerald-300">
        Shinobi Training Log
      </p>
      <h1 class="mt-3 text-4xl font-semibold leading-tight text-zinc-950 dark:text-zinc-50 sm:text-5xl">
        Registre PRs sem brigar com a tela durante o treino.
      </h1>
      <p class="mt-4 text-base leading-7 text-zinc-600 dark:text-zinc-300">
        Atividades globais, atividades proprias e historico privado em um fluxo rapido para celular.
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <%= if @current_scope && @current_scope.user do %>
          <.link
            id="home-records-link"
            navigate={~p"/registros"}
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-zinc-950 px-4 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-zinc-800 active:translate-y-0 dark:bg-emerald-400 dark:text-zinc-950 dark:hover:bg-emerald-300"
          >
            <.icon name="hero-trophy" class="size-5" /> Abrir historico
          </.link>
          <.link
            id="home-activities-link"
            navigate={~p"/atividades"}
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 text-sm font-semibold text-zinc-800 transition hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
          >
            <.icon name="hero-list-bullet" class="size-5" /> Ver atividades
          </.link>
        <% else %>
          <.link
            id="home-login-link"
            navigate={~p"/users/log-in"}
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-zinc-950 px-4 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-zinc-800 active:translate-y-0 dark:bg-emerald-400 dark:text-zinc-950 dark:hover:bg-emerald-300"
          >
            Entrar
          </.link>
          <.link
            id="home-register-link"
            navigate={~p"/users/register"}
            class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 text-sm font-semibold text-zinc-800 transition hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
          >
            Criar conta
          </.link>
        <% end %>
      </div>
    </div>

    <div class="grid gap-3">
      <div class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Cindy com carga</p>
            <p class="mt-1 text-3xl font-semibold text-emerald-700 dark:text-emerald-300">
              18.5 voltas / 9 kg
            </p>
          </div>
          <.icon name="hero-trophy" class="size-8 text-emerald-600 dark:text-emerald-300" />
        </div>
      </div>

      <div class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Karen</p>
            <p class="mt-1 text-3xl font-semibold text-zinc-950 dark:text-zinc-50">
              7:42 / 9 kg
            </p>
          </div>
          <.icon name="hero-clock" class="size-8 text-sky-600 dark:text-sky-300" />
        </div>
      </div>

      <div class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Bench Press</p>
            <p class="mt-1 text-3xl font-semibold text-zinc-950 dark:text-zinc-50">
              3 reps / 70 kg
            </p>
          </div>
          <.icon name="hero-scale" class="size-8 text-amber-600 dark:text-amber-300" />
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
